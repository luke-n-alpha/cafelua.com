# ============================================
# Cafe Lua Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# .env is gitignored and will not be committed

# --------------------------------------------
# Naia AI Gateway (Required for Coffee Chat & Tarot)
# --------------------------------------------
# Server-side Google AI Studio key. Never expose it as NEXT_PUBLIC_*.
NAIA_KEY=
# Optional gateway override. Default: https://api.nextain.io/v1
NAIA_BASE_URL=https://api.nextain.io/v1

# Default model used by Cafe Lua AI routes.
# Coffee chat and tarot chat default to deepseek-v4-flash.
CAFELUA_COFFEE_CHAT_MODEL=deepseek-v4-flash
CAFELUA_TAROT_CHAT_MODEL=deepseek-v4-flash

# --------------------------------------------
# Alpha's Secret Information (Optional)
# --------------------------------------------
# Secret phrase for master (Luke) recognition
ALPHA_SECRET_PHRASE=

# Family members (JSON format)
# Example: {"이름":{"relation":"daughter|son|wife","nickname":"별명","info":"추가정보"}}
ALPHA_FAMILY_MEMBERS=

# Master's birthday (for Alpha to remember)
ALPHA_MASTER_BIRTHDAY=

# --------------------------------------------
# Weather API (Optional)
# --------------------------------------------
# OpenWeatherMap API for auto weather detection
# Get your key from: https://openweathermap.org/
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# --------------------------------------------
# Firebase (Required for Guestbook)
# --------------------------------------------
# Create a Firebase project and register a web app
# https://console.firebase.google.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (Server-side only, from service account key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --------------------------------------------
# GA4 Visitor Counter (Optional)
# --------------------------------------------
# Shows a retro visitor counter on the intro page.
# 1. Get your Property ID from: Google Analytics > Admin > Property Settings
# 2. Enable "Google Analytics Data API" in Google Cloud Console
# 3. Grant "Viewer" role to FIREBASE_CLIENT_EMAIL in GA4:
#    Admin > Property Access Management > Add users > Viewer
GA4_PROPERTY_ID=
# Metric for counter (default: screenPageViews)
# Example alternatives: totalUsers, sessions
GA4_VISITOR_METRIC=screenPageViews
# Start date for cumulative counter (YYYY-MM-DD)
GA4_COUNTER_START_DATE=2025-11-20
